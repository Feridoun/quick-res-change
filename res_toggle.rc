#include <windows.h>
#include "resource.h"

// Two icons so the tray visibly reflects which state we're in.
IDI_ICON_BASE    ICON  "icon_base.ico"
IDI_ICON_CHOSEN  ICON  "icon_chosen.ico"

IDD_SETTINGS DIALOGEX 0, 0, 230, 134
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Res Toggle Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Usual resolution:",     -1,            10, 12, 85, 10
    COMBOBOX        IDC_PRIMARY,             100, 10, 120, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Secondary resolution:", -1,            10, 32, 85, 10
    COMBOBOX        IDC_SECONDARY,           100, 30, 120, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Third resolution:",     IDC_USE_THIRD, 10, 52, 85, 10
    COMBOBOX        IDC_THIRD,               100, 50, 120, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Left-click the tray icon to cycle through these in order.", -1, 10, 72, 210, 10
    AUTOCHECKBOX    "Start with Windows",    IDC_AUTOSTART, 10, 90, 150, 10
    DEFPUSHBUTTON   "OK",     IDOK,     114, 112, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 170, 112, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,2,0,0
PRODUCTVERSION  1,2,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName",      "Feridoun"
            VALUE "FileDescription",  "Res Toggle - tray resolution switcher"
            VALUE "FileVersion",      "1.2.0"
            VALUE "InternalName",     "res_toggle"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Feridoun. MIT License."
            VALUE "OriginalFilename", "res_toggle.exe"
            VALUE "ProductName",      "Res Toggle"
            VALUE "ProductVersion",   "1.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
END
